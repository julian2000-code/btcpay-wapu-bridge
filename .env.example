# BTCPay Server
BTCPAY_URL=http://127.0.0.1:8080
BTCPAY_API_KEY=your_btcpay_api_key_here
BTCPAY_WEBHOOK_SECRET=your_webhook_secret_here
BTCPAY_STORE_ID=your_store_id_here

# WapuPay — use API key if you have one, otherwise email + password
WAPU_API_BASE_URL=https://be-stage.wapu.app
WAPU_API_KEY=                        # preferred — permanent key from "wapu api-token"
WAPU_EMAIL=your_wapu_email_here      # fallback if no API key
WAPU_PASSWORD=your_wapu_password_here
WAPU_WITHDRAW_ALIAS=your_alias_here  # Argentine bank alias to receive ARS
WAPU_RECEIVER_NAME=Your Name Here
